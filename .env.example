# Copy to .env for local development. Never commit the real .env.
#
# IMPORTANT: every entrypoint calls load_dotenv(override=True), so this file always
# wins over a stray shell export of the same variable — but that also means DATABASE_URL
# below is genuinely authoritative. Comment out the line you're not using.

# --- Database: pick ONE path ---

# Local/dev (Homebrew Postgres 17 + pgvector):
DATABASE_URL=postgresql+psycopg://localhost:5432/research_copilot_dev

# Lakebase — same DATABASE_URL variable, pointed at Lakebase's host with a native
# Postgres role (see lakebase_app_user_grants.sql for creating/granting app_user).
# This is the connection the running app actually uses in production, not the
# credential-flow variables further below — a real password means no token-refresh
# logic is needed in the request path, and the code path is identical to local dev.
# DATABASE_URL=postgresql+psycopg://app_user:<password>@<lakebase-host>/databricks_postgres?sslmode=require

# --- Lakebase: OAuth credential-flow alternative (leave DATABASE_URL unset to use this) ---
# Short-lived, auto-refreshed credentials tied to a Databricks identity — a better fit
# for a deployed app authenticating as a service principal than for this app's own
# runtime connection, which uses the native-role path above instead.
# DATABRICKS_PROFILE=                            # requires `databricks auth login --profile <name>` first
# LAKEBASE_INSTANCE_NAME=
# LAKEBASE_HOST=
# LAKEBASE_DB_NAME=databricks_postgres
# LAKEBASE_DB_USER=
# LAKEBASE_PORT=5432
#
# Alternative auth to DATABRICKS_PROFILE — a service principal:
# DATABRICKS_HOST=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
#
# One-off manual check only (expires ~1hr, no refresh) — never commit a real value here:
# LAKEBASE_STATIC_TOKEN=

# --- Databricks Foundation Model APIs (embeddings always; chat too, unless the proxy below is set) ---
# Prefer DATABRICKS_PROFILE (OAuth via `databricks auth login`) over DATABRICKS_FM_TOKEN —
# a static PAT may be disabled by org policy; the OAuth path doesn't need one.
# DATABRICKS_FM_BASE_URL=https://<workspace-host>/serving-endpoints
# DATABRICKS_FM_TOKEN=
# LLM_MODEL=databricks-claude-haiku-4-5
# EMBEDDING_MODEL=databricks-qwen3-embedding-0-6b

# --- Chat LLM proxy (optional) — an OpenAI-compatible endpoint that replaces the
# Databricks model for chat only (agent, summaries, reading plans). Checked first;
# when both of these are set, they win over the Databricks chat model above.
# Embeddings/semantic search are untouched and always stay on Databricks — this
# proxy doesn't need to provide an embeddings endpoint.
# CHAT_PROXY_BASE_URL=
# CHAT_PROXY_API_KEY=
# LLM_MODEL=                                     # set to the proxy's own model name when using this path

# --- Chat LLM fallback proxy (optional) — tried only if the primary proxy call above
# fails with an auth/quota error (401/429). A separate model (e.g. an Anthropic model
# through a different proxy) needs its own model id, since it won't share a name with
# the primary proxy's model.
# CHAT_FALLBACK_PROXY_BASE_URL=
# CHAT_FALLBACK_PROXY_API_KEY=
# CHAT_FALLBACK_MODEL=

# --- OpenAlex (optional — works without a key for casual use) ---
# OPENALEX_API_KEY=
# OPENALEX_MAILTO=
